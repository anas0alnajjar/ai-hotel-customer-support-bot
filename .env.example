# Local development template. Copy to .env and replace secrets locally.
# Never commit .env or a real API key.
APP_NAME=AI Hotel Customer Support Bot
APP_ENVIRONMENT=development
APP_DEBUG=false
APP_LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,backend

DB_HOST=127.0.0.1
DB_PORT=3307
DB_HOST_PORT=3307
DB_NAME=hotel_bot
DB_USER=hotel_bot
DB_PASSWORD=hotel_bot_local_password
DB_ROOT_PASSWORD=hotel_bot_local_root_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

CONVERSATION_RETENTION_DAYS=90
CONVERSATION_CONTEXT_TURNS=5
CONVERSATION_CONTEXT_MAX_TOKENS=3000
CONVERSATION_INACTIVITY_MINUTES=30
RETENTION_CLEANUP_BATCH_SIZE=500
INTENT_GENERAL_CONFIDENCE_THRESHOLD=0.60
INTENT_ACTION_CONFIDENCE_THRESHOLD=0.80
INTENT_CONFIDENCE_MARGIN_THRESHOLD=0.15

KNOWLEDGE_INDEX_PATH=backend/data/faiss
KNOWLEDGE_CHUNK_MAX_CHARS=800
KNOWLEDGE_CHUNK_OVERLAP_CHARS=120
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_REVISION=86741b4e3f5cb7765a600d3a3d55a0f6a6cb443d
EMBEDDING_CACHE_PATH=backend/data/models
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.35
TOOL_READ_TIMEOUT_MS=2000
TOOL_WRITE_TIMEOUT_MS=5000
TOOL_MAX_CALLS_PER_TURN=3

GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_TOKENS_PER_TURN=10000
GEMINI_MAX_ESTIMATED_COST_USD_PER_TURN=0.05
GEMINI_INPUT_USD_PER_MILLION_TOKENS=1.50
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=9.00

TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_IDENTITY_PEPPER=replace_with_at_least_32_random_characters
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_MAX_UPDATE_BYTES=262144

ADMIN_TOKEN_SECRET=replace_with_at_least_32_random_characters
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
