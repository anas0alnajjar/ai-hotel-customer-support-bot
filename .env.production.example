# Copy to .env.production on the target host and replace every placeholder.
APP_NAME=AI Hotel Customer Support Bot
APP_ENVIRONMENT=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
PUBLIC_DOMAIN=hotel.example.com
ACME_EMAIL=operator@example.com
HTTP_HOST_PORT=80
HTTPS_HOST_PORT=443
TRUSTED_HOSTS=hotel.example.com,backend

DB_NAME=hotel_bot
DB_USER=hotel_bot
DB_PASSWORD=replace_with_random_database_password
DB_ROOT_PASSWORD=replace_with_random_root_password
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

CONVERSATION_RETENTION_DAYS=90
CONVERSATION_CONTEXT_TURNS=5
CONVERSATION_CONTEXT_MAX_TOKENS=3000
CONVERSATION_INACTIVITY_MINUTES=30
RETENTION_CLEANUP_BATCH_SIZE=500

KNOWLEDGE_INDEX_PATH=/app/data/faiss
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL_REVISION=86741b4e3f5cb7765a600d3a3d55a0f6a6cb443d
EMBEDDING_CACHE_PATH=/app/data/models
EMBEDDING_DIMENSION=384

GEMINI_API_KEY=replace_with_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=20000
GEMINI_RETRY_ATTEMPTS=2
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_MAX_TOKENS_PER_TURN=10000
GEMINI_MAX_ESTIMATED_COST_USD_PER_TURN=0.05

TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_WEBHOOK_SECRET=replace_with_random_webhook_secret
TELEGRAM_IDENTITY_PEPPER=replace_with_at_least_32_random_characters
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEOUT_MS=10000

ADMIN_TOKEN_SECRET=replace_with_at_least_32_random_characters
ADMIN_ACCESS_TOKEN_MINUTES=15
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MINUTES=15
